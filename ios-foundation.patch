new file mode 100644
index 0000000..76ae1c1
--- /dev/null
+++ b/.github/workflows/ci.yml
@@ -0,0 +1,33 @@
+# Runs on every push and pull request.
+#  - android:    the existing unit tests, plus the shared module's tests on the JVM.
+#  - ios-shared: compiles the shared module for iOS and runs its tests on the iOS Simulator.
+#                This is how iOS breakage is caught without owning a Mac. (Kotlin/Native needs a macOS host.)
+# Note: macOS runner minutes are billed at a higher rate than Linux on GitHub's free allowance.
+name: CI
+
+on:
+  push:
+  pull_request:
+
+jobs:
+  android:
+    runs-on: ubuntu-latest
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: 17
+      - uses: gradle/actions/setup-gradle@v4
+      - run: ./gradlew :app:testDebugUnitTest :shared:testDebugUnitTest --stacktrace
+
+  ios-shared:
+    runs-on: macos-14
+    steps:
+      - uses: actions/checkout@v4
+      - uses: actions/setup-java@v4
+        with:
+          distribution: temurin
+          java-version: 17
+      - uses: gradle/actions/setup-gradle@v4
+      - run: ./gradlew :shared:compileKotlinIosArm64 :shared:iosSimulatorArm64Test --stacktrace
